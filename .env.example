# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo

# Structured EHR Database
SQLITE_DB_PATH=./data/healthcare.db

# Vector Database Configuration for RAG documents
CHROMADB_PATH=./data/embeddings/chromadb
FAISS_INDEX_PATH=./data/embeddings/faiss

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
MAX_DOCUMENTS=1000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501
