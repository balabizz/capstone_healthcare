# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo
PLANNER_MODEL=gpt-4o-mini

# Structured EHR Database
SQLITE_DB_PATH=./data/healthcare.db

# Vector Database Configuration for RAG documents
FAISS_INDEX_PATH=./data/embeddings/faiss

# Application Settings
DEBUG=False
LOG_LEVEL=INFO
MAX_DOCUMENTS=1000
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Streamlit Settings
STREAMLIT_SERVER_PORT=8501

# All doctor calendar and appointment times use this clinic timezone.
SCHEDULE_TIMEZONE=Australia/Sydney
# Optional private HTTP transport. Leave URL empty for the same service in-process.
SCHEDULE_API_URL=
SCHEDULE_API_TOKEN=

# Optional NCBI contact/API key; never use the OpenAI key here.
NCBI_EMAIL=
NCBI_API_KEY=
# Publication date window for live PubMed/WHO searches (days).
MEDICAL_SEARCH_DAYS=730

# FAISS patient summaries (stored in the application's SQLite database)
PATIENT_SUMMARY_EMBEDDING_MODEL=text-embedding-3-small

# Appointment panels refresh without rerunning booking forms or LLM calls
APPOINTMENT_REFRESH_SECONDS=5
